# PostgreSQL connection string.
# Local dev example:   postgresql://postgres:postgres@localhost:5432/gst_invoice_dev
# Render Postgres:      copy the "Internal Database URL" from your Render Postgres instance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gst_invoice_dev

# Long, random secret used to sign JWT access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-value

# Comma-separated list of exact origins allowed to call this API with credentials.
# Example: https://your-frontend.onrender.com,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# development | production — enables secure cookies + stricter behavior in production
NODE_ENV=development

PORT=4000
